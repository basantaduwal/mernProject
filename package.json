{
  "name": "mini-daraz",
  "version": "1.0.0",
  "description": "Mini Daraz university project in MERN Stack",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "server:dev": "npm run dev --workspace=server",
    "server:start": "npm run start --workspace=server",
    "client:dev": "npm run dev --workspace=client",
    "client:build": "npm run build --workspace=client",
    "install:all": "npm install",
    "test": "npm run test --workspace=server",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basantaduwal/mernProject.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/basantaduwal/mernProject/issues"
  },
  "homepage": "https://github.com/basantaduwal/mernProject#readme",
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}