# Server Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================================
# SERVER
# ============================================================
PORT=5000
NODE_ENV=development

# ============================================================
# DATABASE
# ============================================================
# Local MongoDB (default)
MONGODB_URI=mongodb://127.0.0.1:27017/mini_daraz

# ============================================================
# JSON WEB TOKEN
# ============================================================
# Generate a strong random secret (min 32 chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_random_secret_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# ============================================================
# GOOGLE OAUTH 2.0
# ============================================================
# Create credentials at: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================================
# CLIENT (CORS)
# ============================================================
CLIENT_URL=http://localhost:5173
