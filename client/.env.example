# Client Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================================
# BACKEND API URL (for production deployment)
# ============================================================
# Set this to your Render backend URL in production
# VITE_API_URL=https://mini-daraz.onrender.com/api
VITE_API_URL=

# ============================================================
# GOOGLE OAUTH 2.0
# ============================================================
# Must match the Client ID in server/.env
# Create credentials at: https://console.cloud.google.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com